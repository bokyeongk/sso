# =============================================================
# API Gateway 환경변수 설정 예시
# 실제 사용 시 이 파일을 .env 로 복사하여 값을 설정하세요.
# cp .env.example .env
# =============================================================

# 게이트웨이 서버 포트
SERVER_PORT=8000

# SSO 백엔드 서비스 URI (인증 처리 서버)
SSO_SERVICE_URI=http://localhost:8080

# SJEasy 서비스 URI
SJEASY_SERVICE_URI=http://localhost:8081

# SSO 토큰 검증 엔드포인트 URL (인증 필터에서 토큰 유효성 확인에 사용)
SSO_INTROSPECT_URL=http://localhost:8080/api/auth/me

# 로그인 페이지 URL (인증 실패 시 리다이렉트 대상)
SSO_LOGIN_PAGE_URL=http://localhost:5173/login

# CORS 허용 Origin (프론트엔드 주소)
ALLOWED_ORIGIN=http://localhost:5173
